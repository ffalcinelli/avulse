; Installs avulse.sys as an NDIS lightweight filter (a modifying filter on Ethernet adapters), for
; the ETHERNET layer. The same driver serves the other layers through WFP; without this INF, it
; also loads as a plain kernel service (sc.exe create avulse type= kernel ...), which is how the
; user-mode backend starts it.
;
;   netcfg.exe -v -l avulse.inf -c s -i avulse     ; install, bind and start
;   netcfg.exe -v -u avulse                        ; uninstall and unload

[Version]
Signature        = "$WINDOWS NT$"
Class            = NetService
ClassGUID        = {4D36E974-E325-11CE-BFC1-08002BE10318}
Provider         = %Avulse%
CatalogFile      = avulse.cat
DriverVer        =
PnpLockdown      = 1

[Manufacturer]
%Avulse% = Avulse, NT$ARCH$.10.0...16299

[Avulse.NT$ARCH$.10.0...16299]
%AvulseDriver.Desc% = Install, avulse

[Install]
AddReg           = Install.AddReg
Characteristics  = 0x40000                          ; NCF_LW_FILTER
NetCfgInstanceId = "{3c1d6e52-8b7a-4f19-a2d4-5e9b0c71f846}"
CopyFiles        = Install.CopyFiles

[SourceDisksNames]
1 = %DiskDescription%,,,

[SourceDisksFiles]
avulse.sys = 1

[DestinationDirs]
Install.CopyFiles = 13

[Install.CopyFiles]
avulse.sys,,,2

[Install.Services]
AddService = avulse,, Service.Install

[Service.Install]
DisplayName      = %AvulseDriver.Desc%
ServiceType      = 1                                ; SERVICE_KERNEL_DRIVER
StartType        = 1                                ; SERVICE_SYSTEM_START
ErrorControl     = 1                                ; SERVICE_ERROR_NORMAL
ServiceBinary    = %13%\avulse.sys
LoadOrderGroup   = NDIS
Description      = %AvulseDriver.Desc%
AddReg           = Service.AddReg

[Install.Remove.Services]
DelService       = avulse, 0x200              ; SPSVCINST_STOPSERVICE

[Install.AddReg]
HKR, Ndi, Service, 0, "avulse"
HKR, Ndi, CoServices, 0x00010000, "avulse"
HKR, Ndi, HelpText, 0, %AvulseDriver.Help%
HKR, Ndi, FilterClass, 0, custom
HKR, Ndi, FilterType, 0x00010001, 2                 ; modifying
HKR, Ndi, FilterRunType, 0x00010001, 2              ; optional: the stack works without it
HKR, Ndi\Interfaces, UpperRange, 0, "noupper"
HKR, Ndi\Interfaces, LowerRange, 0, "nolower"
HKR, Ndi\Interfaces, FilterMediaTypes, 0, "ethernet"

[Service.AddReg]
HKR, Parameters, NdisImPlatformBindingOptions, 0x00010001, 0

[Strings]
Avulse            = "Avulse"
AvulseDriver.Desc  = "Avulse packet filter"
AvulseDriver.Help  = "Diverts, modifies and reinjects network packets (avulse)"
DiskDescription   = "Avulse driver"
